# Copy this file to .env and set real value(s).
# Comma-separated list -- any of these tokens is accepted. When DEMO_TOKENS is
# unset (no .env, or this line missing/blank), the demo runs with no token
# gate -- anyone who can reach the port has full access.
DEMO_TOKENS=sk_gbdtgtfs_changeme1,sk_gbdtgtfs_changeme2
